<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Lets a debug build reach a backend over plain HTTP; see the config
         file for why that is otherwise blocked. Merged into the debug APK
         only - src/main declares no networkSecurityConfig, so there is nothing
         here to override, and the release APK stays HTTPS-only. -->
    <application android:networkSecurityConfig="@xml/network_security_config"/>
</manifest>
